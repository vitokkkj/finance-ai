# Copie este arquivo para .env e substitua o valor de POSTGRES_PASSWORD.
# Use apenas letras e números para evitar codificação especial na URL local.
POSTGRES_DB=finance_ai
POSTGRES_USER=finance_ai
POSTGRES_PASSWORD=SUBSTITUAESTEPORUMASEGREDOALEATORIO

# Configuração local. A API e o worker recebem estas opções pelo Compose.
APP_ENV=development
SESSION_COOKIE_SECURE=false
SESSION_TTL_HOURS=24
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=3000
WEB_ALLOWED_DEV_ORIGINS=127.0.0.1
INITIAL_SETUP_TOKEN=
MFA_ENROLLMENT_TOKEN=
OWNER_TOTP_SECRET=
CLOUDFLARE_TUNNEL_TOKEN_FILE=./secrets/cloudflare-tunnel-token

# Usa a franquia da conta ChatGPT autorizada; não usa API key nem faz fallback pago.
AI_PROVIDER=chatgpt_plan
AI_MODEL_FAST=gpt-6-luna
AI_MODEL_SMART=gpt-6.1-sol
OLLAMA_MODEL_LOCAL=qwen3:1.7b
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_TIMEOUT_SECONDS=900
OLLAMA_KEEP_ALIVE=5m
OLLAMA_VOLUME_NAME=finance-ai_ollama_data

# Ollama é um modo local opcional; inicie com --profile local-ai.
